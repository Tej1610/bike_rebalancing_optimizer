{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "CLI: compare Greedy vs DP",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": ["--stations", "12", "--trucks", "3", "--capacity", "10", "--algo", "compare"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
